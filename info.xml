<?xml version="1.0" encoding="utf-8"?>
<jtlshopplugin>
    <Name>Artikeldetails Plus</Name>
    <Description>Extra Artikeldetails aus dem eigentlichen Template in ein Plugin überführt.</Description>
    <Author>Oliver Kamps</Author>
    <URL>https://ollipolli.de</URL>
    <XMLVersion>102</XMLVersion>
    <MinShopVersion>5.5.1</MinShopVersion>
    <MaxShopVersion>5.8.0</MaxShopVersion>
    <PluginID>artikel_details_plus</PluginID>
    <Version>0.11.0</Version>
    <CreateDate>2025-06-12</CreateDate>
    <Install>
        <Emailtemplate>
            <Template>
                <Name>Günstiger gesehen Benachrichtigung</Name>
                <Description>Benachrichtigung wenn ein Kunde einen günstigeren Preis meldet.</Description>
                <Type>text/html</Type>
                <ModulId>guenstigergesehen</ModulId>
                <Active>Y</Active>
                <AKZ>0</AKZ>
                <AGB>0</AGB>
                <WRB>0</WRB>
                <WRBForm>0</WRBForm>
                <DSE>0</DSE>
                <TemplateLanguage iso="GER">
                    <Subject>Günstiger gesehen: {$oPluginMail->cArtikelName}</Subject>
                    <ContentHtml><![CDATA[
<p>Ein Kunde hat einen günstigeren Preis gemeldet.</p>
<table cellpadding="5">
    <tr><td><strong>Artikel:</strong></td><td>{$oPluginMail->cArtikelName}</td></tr>
    <tr><td><strong>E-Mail:</strong></td><td>{$oPluginMail->cEmail}</td></tr>
    <tr><td><strong>Link:</strong></td><td><a href="{$oPluginMail->cURL}">{$oPluginMail->cURL}</a></td></tr>
    {if $oPluginMail->cNachricht}
    <tr><td><strong>Nachricht:</strong></td><td>{$oPluginMail->cNachricht}</td></tr>
    {/if}
</table>
                    ]]></ContentHtml>
                    <ContentText>Günstiger gesehen: {$oPluginMail->cArtikelName}

Artikel:  {$oPluginMail->cArtikelName}
E-Mail:   {$oPluginMail->cEmail}
Link:     {$oPluginMail->cURL}
{if $oPluginMail->cNachricht}Nachricht: {$oPluginMail->cNachricht}{/if}</ContentText>
                </TemplateLanguage>
            </Template>
        </Emailtemplate>
        <Adminmenu>
            <Settingslink sort="1">
                <Name>Fahreigenschaften</Name>
                <Setting type="text" initialValue="" sort="0" conf="N">
                    <Name>Allgemein</Name>
                    <Description>Allgemeine Einstellungen des Plugins</Description>
                    <ValueName>Spacer1</ValueName>
                </Setting>
                <Setting type="checkbox" sort="1" conf="Y">
                    <Name>Merkmalwert Anzeige auf Artikeldetailseite aktivieren</Name>
                    <Description>Aktiviert die Anzeige der Merkmalswerte auf der Artikeldetailseite.</Description>
                    <ValueName>artikel_details_plus_merkmalwerte_aktiv</ValueName>
                </Setting>
                <Setting type="checkbox" sort="2" conf="Y">
                    <Name>Fahrlevelanzeige aktivieren</Name>
                    <Description>Aktiviert die Anzeige der Fahrlevel auf der Artikeldetailseite.</Description>
                    <ValueName>artikel_details_plus_fahrlevel_aktiv</ValueName>
                </Setting>
                <Setting type="checkbox" sort="3" conf="Y">
                    <Name>Fahreigenschaften-Diagramm anzeigen</Name>
                    <Description>Zeigt das Diagramm der Fahreigenschaften (Carving, Jib, Powder, All-Mountain, Jump) im Beschreibungs-Tab. Liest die Funktionsattribute carving, jib, powder, all_mountain und jump (0 bis 10), ersatzweise vom Vaterartikel.</Description>
                    <ValueName>artikel_details_plus_specs_characteristics_aktiv</ValueName>
                </Setting>
                <Setting type="checkbox" initialValue="on" sort="5" conf="Y">
                    <Name>Profil-Zonen farbig markieren</Name>
                    <Description>Teilt die Seitenansicht des Profils farbig in ihre Abschnitte (Camber, Rocker, Flat, Kick) und zeigt eine Legende. Abgewählt wird das Profil einfarbig gezeichnet.</Description>
                    <ValueName>artikel_details_plus_profile_zones_aktiv</ValueName>
                </Setting>
                <Setting type="checkbox" sort="4" conf="Y">
                    <Name>Dimensionen anzeigen</Name>
                    <Description>Zeigt Länge, Form, Shape, Waist, Nose, Tail und Inserts als Tabelle mit maßstäblicher Board-Skizze im Beschreibungs-Tab. Die Skizze erscheint, sobald shape gepflegt ist; fehlende Breiten werden generisch gezeichnet. Liest die Funktionsattribute form, shape, waist, nose, tail (mm), laenge (cm, ersatzweise aus der Variation "Länge"), inserts (channel, 2x4, 4x4), optional outline (twin, directional, directional twin), stance und setback (cm) – jeweils ersatzweise vom Vaterartikel.</Description>
                    <ValueName>artikel_details_plus_specs_dimensions_aktiv</ValueName>
                </Setting>
            </Settingslink>
            <Settingslink sort="2">
                <Name>Merkmalbilder</Name>
                <Setting type="text" initialValue="" sort="0" conf="N">
                    <Name>Allgemein</Name>
                    <Description>Allgemeine Einstellungen der Merkmalsbilder</Description>
                    <ValueName>Spacer2</ValueName>
                </Setting>
                <Setting type="checkbox" sort="1" conf="Y">
                    <Name>Merkmalbilder Anzeige aktivieren</Name>
                    <Description>Aktiviert die Anzeige der Merkmalsbilder im Artikeldetail.</Description>
                    <ValueName>artikel_details_plus_merkmalbilder_aktiv</ValueName>
                </Setting>
                <Setting type="selectbox" initialValue="1" sort="2" conf="Y" multiple="Y">
                    <Name>Merkmalwerte mit Bildern</Name>
                    <Description>Wählen Sie die Merkmale aus, die auf der Artikeldetailseite mit Bildern angezeigt werden sollen.</Description>
                    <ValueName>artikel_details_plus_merkmalwerte</ValueName>
                    <OptionsSource>
                        <File>merkmalwerte.php</File>
                    </OptionsSource>
                    <SelectboxOptions>
                        <Option value="0" sort="1">Leider fehlgeschlagen</Option>
                    </SelectboxOptions>
                </Setting>
            </Settingslink>
            <Settingslink sort="3">
                <Name>Merkmal-Zuordnung</Name>
                <Setting type="text" initialValue="" sort="0" conf="N">
                    <Name>Merkmale als Ersatz für Funktionsattribute</Name>
                    <Description>Hat ein Artikel das Funktionsattribut nicht (auch nicht am Vaterartikel), liest die Anzeige die Werte aus dem hier zugeordneten Merkmal – zuerst vom Artikel, sonst vom Vaterartikel, immer in der Standardsprache. Gepflegte Funktionsattribute haben Vorrang.</Description>
                    <ValueName>Spacer3</ValueName>
                </Setting>
                <Setting type="selectbox" initialValue="0" sort="1" conf="Y">
                    <Name>Flex</Name>
                    <Description>Ersatz für flex bzw. flex_ab/flex_bis. Zahlen 1-10 ("6", "5-7", "6/10"; mehrere Werte ergeben den Bereich) oder Wörter wie Soft, Medium, Stiff bzw. weich, mittel, hart.</Description>
                    <ValueName>artikel_details_plus_merkmal_flex</ValueName>
                    <OptionsSource>
                        <File>merkmale.php</File>
                    </OptionsSource>
                    <SelectboxOptions>
                        <Option value="0" sort="1">– kein Merkmal –</Option>
                    </SelectboxOptions>
                </Setting>
                <Setting type="selectbox" initialValue="0" sort="2" conf="Y">
                    <Name>Fahrlevel</Name>
                    <Description>Ersatz für fahrlevel_ab/fahrlevel_bis. Werte Beginner/Anfänger/Einsteiger, Advanced/Fortgeschritten, Professional/Profi/Experte; mehrere Werte ergeben den Bereich.</Description>
                    <ValueName>artikel_details_plus_merkmal_fahrlevel</ValueName>
                    <OptionsSource>
                        <File>merkmale.php</File>
                    </OptionsSource>
                    <SelectboxOptions>
                        <Option value="0" sort="1">– kein Merkmal –</Option>
                    </SelectboxOptions>
                </Setting>
                <Setting type="selectbox" initialValue="0" sort="3" conf="Y">
                    <Name>Körpergewicht</Name>
                    <Description>Ersatz für koerpergewicht_ab/koerpergewicht_bis. Werte wie "50 - 70 kg"; bei mehreren Werten gilt kleinste bis größte Zahl.</Description>
                    <ValueName>artikel_details_plus_merkmal_koerpergewicht</ValueName>
                    <OptionsSource>
                        <File>merkmale.php</File>
                    </OptionsSource>
                    <SelectboxOptions>
                        <Option value="0" sort="1">– kein Merkmal –</Option>
                    </SelectboxOptions>
                </Setting>
                <Setting type="selectbox" initialValue="0" sort="4" conf="Y">
                    <Name>Brettlänge</Name>
                    <Description>Ersatz für laenge. Werte wie "156", "156 cm" oder "156 Wide". Wird nur verwendet, wenn am Artikel (bzw. Vaterartikel) genau eine Länge gepflegt ist – sonst gilt die gewählte Variation.</Description>
                    <ValueName>artikel_details_plus_merkmal_laenge</ValueName>
                    <OptionsSource>
                        <File>merkmale.php</File>
                    </OptionsSource>
                    <SelectboxOptions>
                        <Option value="0" sort="1">– kein Merkmal –</Option>
                    </SelectboxOptions>
                </Setting>
                <Setting type="selectbox" initialValue="0" sort="5" conf="Y">
                    <Name>Form (Profil)</Name>
                    <Description>Ersatz für form, z. B. "Hybrid Camber" oder "Rocker". Steuert Profil-Seitenansicht und Tabellenzeile Form.</Description>
                    <ValueName>artikel_details_plus_merkmal_form</ValueName>
                    <OptionsSource>
                        <File>merkmale.php</File>
                    </OptionsSource>
                    <SelectboxOptions>
                        <Option value="0" sort="1">– kein Merkmal –</Option>
                    </SelectboxOptions>
                </Setting>
                <Setting type="selectbox" initialValue="0" sort="6" conf="Y">
                    <Name>Shape (Umriss)</Name>
                    <Description>Ersatz für shape, z. B. "True Twin" oder "Directional". Steuert den Umriss der Board-Skizze und die Tabellenzeile Shape.</Description>
                    <ValueName>artikel_details_plus_merkmal_shape</ValueName>
                    <OptionsSource>
                        <File>merkmale.php</File>
                    </OptionsSource>
                    <SelectboxOptions>
                        <Option value="0" sort="1">– kein Merkmal –</Option>
                    </SelectboxOptions>
                </Setting>
                <Setting type="selectbox" initialValue="0" sort="7" conf="Y">
                    <Name>Inserts</Name>
                    <Description>Ersatz für inserts: Werte mit "Channel", "2x4" oder "4x4".</Description>
                    <ValueName>artikel_details_plus_merkmal_inserts</ValueName>
                    <OptionsSource>
                        <File>merkmale.php</File>
                    </OptionsSource>
                    <SelectboxOptions>
                        <Option value="0" sort="1">– kein Merkmal –</Option>
                    </SelectboxOptions>
                </Setting>
            </Settingslink>
            <Settingslink sort="4">
                <Name>Lagerbestandsanzeige</Name>
                <Setting type="text" initialValue="" sort="0" conf="N">
                    <Name>Allgemein</Name>
                    <Description>Allgemeine Einstellungen der Lagerbestandsanzeige</Description>
                    <ValueName>Spacer4</ValueName>
                </Setting>
                <Setting type="checkbox" sort="1" conf="Y">
                    <Name>Lagerbestandsanzeige aktivieren</Name>
                    <Description>Aktiviert die Anzeige des Lagerbestands auf der Artikeldetailseite.</Description>
                    <ValueName>artikel_details_plus_lagerbestand_aktiv</ValueName>
                </Setting>
                <Setting type="number" initialValue="10" sort="2" conf="Y">
                    <Name>Nur bei Lagerbestand unter</Name>
                    <Description>Aktiviert die Anzeige des Lagerbestands nur, wenn der Lagerbestand unter dem angegebenen Wert liegt.</Description>
                    <ValueName>artikel_details_plus_lagerbestand_wert</ValueName>
                </Setting>
                <Setting type="color" initialValue="#ffa54f" sort="3" conf="Y">
                    <Name>Farbe der Anzeige</Name>
                    <Description>Wählen Sie die Farbe für die Lagerbestandsanzeige.</Description>
                    <ValueName>artikel_details_plus_lagerbestand_farbe</ValueName>
                </Setting>
            </Settingslink>
            <Settingslink sort="5">
                <Name>Günstiger gesehen</Name>
                <Setting type="text" initialValue="" sort="0" conf="N">
                    <Name>Allgemein</Name>
                    <Description>Einstellungen für das "Günstiger gesehen?"-Formular</Description>
                    <ValueName>Spacer5</ValueName>
                </Setting>
                <Setting type="checkbox" sort="1" conf="Y">
                    <Name>Formular aktivieren</Name>
                    <Description>Aktiviert den "Günstiger gesehen?"-Button und das Formular auf der Artikeldetailseite.</Description>
                    <ValueName>artikel_details_plus_cheaper_aktiv</ValueName>
                </Setting>
            </Settingslink>
        </Adminmenu>
        <Locales>
            <Variable>
                <Name>artikel_details_plus_weight_title</Name>
                <Description>Überschrift der Körpergewichtsleiste</Description>
                <VariableLocalized iso="GER">Empfohlenes Körpergewicht:</VariableLocalized>
                <VariableLocalized iso="ENG">Suggested Weight:</VariableLocalized>
            </Variable>
            <Variable>
                <Name>artikel_details_plus_level_title</Name>
                <Description>Überschrift der Fahrlevel-Leiste</Description>
                <VariableLocalized iso="GER">Fahrlevel:</VariableLocalized>
                <VariableLocalized iso="ENG">Rider Skills:</VariableLocalized>
            </Variable>
            <Variable>
                <Name>artikel_details_plus_level_beginner</Name>
                <Description>Fahrlevel-Stufe 1 (fahrlevel Beginner)</Description>
                <VariableLocalized iso="GER">Beginner</VariableLocalized>
                <VariableLocalized iso="ENG">Beginner</VariableLocalized>
            </Variable>
            <Variable>
                <Name>artikel_details_plus_level_intermediate</Name>
                <Description>Fahrlevel-Stufe 2 (fahrlevel Advanced/Intermediate)</Description>
                <VariableLocalized iso="GER">Intermediate</VariableLocalized>
                <VariableLocalized iso="ENG">Intermediate</VariableLocalized>
            </Variable>
            <Variable>
                <Name>artikel_details_plus_level_expert</Name>
                <Description>Fahrlevel-Stufe 3 (fahrlevel Professional/Expert)</Description>
                <VariableLocalized iso="GER">Advanced/Expert</VariableLocalized>
                <VariableLocalized iso="ENG">Advanced/Expert</VariableLocalized>
            </Variable>
            <Variable>
                <Name>artikel_details_plus_specs_heading_profile</Name>
                <Description>Überschrift der Profil-Seitenansicht (Camber/Rocker)</Description>
                <VariableLocalized iso="GER">Profil</VariableLocalized>
                <VariableLocalized iso="ENG">Profile</VariableLocalized>
            </Variable>
            <Variable>
                <Name>artikel_details_plus_profile_zone_camber</Name>
                <Description>Legende Profil: Positive-Camber-Zone</Description>
                <VariableLocalized iso="GER">Camber</VariableLocalized>
                <VariableLocalized iso="ENG">Camber</VariableLocalized>
            </Variable>
            <Variable>
                <Name>artikel_details_plus_profile_zone_rocker</Name>
                <Description>Legende Profil: Rocker-/Reverse-Camber-Zone</Description>
                <VariableLocalized iso="GER">Rocker</VariableLocalized>
                <VariableLocalized iso="ENG">Rocker</VariableLocalized>
            </Variable>
            <Variable>
                <Name>artikel_details_plus_profile_zone_flat</Name>
                <Description>Legende Profil: Flat-/Zero-Camber-Zone</Description>
                <VariableLocalized iso="GER">Flat</VariableLocalized>
                <VariableLocalized iso="ENG">Flat</VariableLocalized>
            </Variable>
            <Variable>
                <Name>artikel_details_plus_profile_zone_kick</Name>
                <Description>Legende Profil: Aufbiegung von Nose und Tail</Description>
                <VariableLocalized iso="GER">Kick</VariableLocalized>
                <VariableLocalized iso="ENG">Kick</VariableLocalized>
            </Variable>
            <Variable>
                <Name>artikel_details_plus_flex_title</Name>
                <Description>Überschrift der Flex-Skala</Description>
                <VariableLocalized iso="GER">Flex</VariableLocalized>
                <VariableLocalized iso="ENG">Flex</VariableLocalized>
            </Variable>
            <Variable>
                <Name>artikel_details_plus_flex_zone_soft</Name>
                <Description>Flex-Zone 1-2</Description>
                <VariableLocalized iso="GER">Soft</VariableLocalized>
                <VariableLocalized iso="ENG">Soft</VariableLocalized>
            </Variable>
            <Variable>
                <Name>artikel_details_plus_flex_zone_medium_soft</Name>
                <Description>Flex-Zone 3-4</Description>
                <VariableLocalized iso="GER">Medium-Soft</VariableLocalized>
                <VariableLocalized iso="ENG">Medium-Soft</VariableLocalized>
            </Variable>
            <Variable>
                <Name>artikel_details_plus_flex_zone_medium</Name>
                <Description>Flex-Zone 5-6</Description>
                <VariableLocalized iso="GER">Medium</VariableLocalized>
                <VariableLocalized iso="ENG">Medium</VariableLocalized>
            </Variable>
            <Variable>
                <Name>artikel_details_plus_flex_zone_medium_stiff</Name>
                <Description>Flex-Zone 7-8</Description>
                <VariableLocalized iso="GER">Medium-Stiff</VariableLocalized>
                <VariableLocalized iso="ENG">Medium-Stiff</VariableLocalized>
            </Variable>
            <Variable>
                <Name>artikel_details_plus_flex_zone_stiff</Name>
                <Description>Flex-Zone 9-10</Description>
                <VariableLocalized iso="GER">Stiff</VariableLocalized>
                <VariableLocalized iso="ENG">Stiff</VariableLocalized>
            </Variable>
            <Variable>
                <Name>artikel_details_plus_stock_text</Name>
                <Description>Text der Lagerbestandsanzeige, %s wird durch die Stückzahl ersetzt</Description>
                <VariableLocalized iso="GER">Nur noch %s Stück verfügbar!</VariableLocalized>
                <VariableLocalized iso="ENG">Only %s pieces available!</VariableLocalized>
            </Variable>
            <Variable>
                <Name>artikel_details_plus_specs_heading_characteristics</Name>
                <Description>Überschrift des Fahreigenschaften-Diagramms</Description>
                <VariableLocalized iso="GER">Fahreigenschaften</VariableLocalized>
                <VariableLocalized iso="ENG">Ride Characteristics</VariableLocalized>
            </Variable>
            <Variable>
                <Name>artikel_details_plus_specs_heading_dimensions</Name>
                <Description>Überschrift der Dimensionen-Darstellung</Description>
                <VariableLocalized iso="GER">Dimensionen</VariableLocalized>
                <VariableLocalized iso="ENG">Dimensions</VariableLocalized>
            </Variable>
            <Variable>
                <Name>artikel_details_plus_form_button</Name>
                <Description>Button Text für Formular - günstiger gesehen</Description>
                <VariableLocalized iso="GER">Günstiger gesehen?</VariableLocalized>
                <VariableLocalized iso="ENG">Seen it cheaper?</VariableLocalized>
            </Variable>
            <Variable>
                <Name>artikel_details_plus_cheaper_title</Name>
                <Description>Titel des Modals "Günstiger gesehen"</Description>
                <VariableLocalized iso="GER">Günstiger gesehen?</VariableLocalized>
                <VariableLocalized iso="ENG">Seen it cheaper?</VariableLocalized>
            </Variable>
            <Variable>
                <Name>artikel_details_plus_cheaper_success</Name>
                <Description>Erfolgsmeldung nach Formular-Absenden</Description>
                <VariableLocalized iso="GER">Vielen Dank! Wir haben Ihren Preishinweis erhalten und werden ihn prüfen.</VariableLocalized>
                <VariableLocalized iso="ENG">Thank you! We have received your price tip and will review it.</VariableLocalized>
            </Variable>
            <Variable>
                <Name>artikel_details_plus_cheaper_err_validation</Name>
                <Description>Fehlermeldung bei ungültigen Formularfeldern</Description>
                <VariableLocalized iso="GER">Bitte füllen Sie E-Mail-Adresse und Link korrekt aus.</VariableLocalized>
                <VariableLocalized iso="ENG">Please enter a valid email address and link.</VariableLocalized>
            </Variable>
            <Variable>
                <Name>artikel_details_plus_cheaper_err_csrf</Name>
                <Description>Fehlermeldung bei ungültigem Sicherheitstoken</Description>
                <VariableLocalized iso="GER">Ungültige Anfrage. Bitte laden Sie die Seite neu und versuchen Sie es erneut.</VariableLocalized>
                <VariableLocalized iso="ENG">Invalid request. Please reload the page and try again.</VariableLocalized>
            </Variable>
            <Variable>
                <Name>artikel_details_plus_cheaper_err_general</Name>
                <Description>Allgemeine Fehlermeldung beim Formular</Description>
                <VariableLocalized iso="GER">Beim Senden ist ein Fehler aufgetreten. Bitte versuchen Sie es später erneut.</VariableLocalized>
                <VariableLocalized iso="ENG">An error occurred while sending. Please try again later.</VariableLocalized>
            </Variable>
            <Variable>
                <Name>artikel_details_plus_cheaper_label_email</Name>
                <Description>Label für das E-Mail-Feld</Description>
                <VariableLocalized iso="GER">Ihre E-Mail-Adresse *</VariableLocalized>
                <VariableLocalized iso="ENG">Your email address *</VariableLocalized>
            </Variable>
            <Variable>
                <Name>artikel_details_plus_cheaper_label_url</Name>
                <Description>Label für das URL-Feld</Description>
                <VariableLocalized iso="GER">Link zum günstigeren Angebot *</VariableLocalized>
                <VariableLocalized iso="ENG">Link to the cheaper offer *</VariableLocalized>
            </Variable>
            <Variable>
                <Name>artikel_details_plus_cheaper_label_message</Name>
                <Description>Label für das Nachrichtenfeld</Description>
                <VariableLocalized iso="GER">Nachricht (optional)</VariableLocalized>
                <VariableLocalized iso="ENG">Message (optional)</VariableLocalized>
            </Variable>
            <Variable>
                <Name>artikel_details_plus_cheaper_submit</Name>
                <Description>Text des Absenden-Buttons im "Günstiger gesehen"-Formular</Description>
                <VariableLocalized iso="GER">Abschicken</VariableLocalized>
                <VariableLocalized iso="ENG">Submit</VariableLocalized>
            </Variable>
        </Locales>
    </Install>

</jtlshopplugin>